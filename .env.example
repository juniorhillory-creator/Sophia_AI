# Sophia AI — Environment Configuration
# Copy this file to .env and customize for your environment
# DO NOT COMMIT THIS FILE TO VERSION CONTROL

# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection (used for user accounts, auth tokens, document metadata)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@localhost:5432/sophia_ai

# PostgreSQL credentials
POSTGRES_PASSWORD=your_secure_password_here

# ===========================================
# ChromaDB Vector Database
# ===========================================
# Path where ChromaDB stores vector embeddings (persisted on disk)
CHROMA_PATH=./data/chroma

# ===========================================
# Ollama LLM Server
# ===========================================
# Ollama server URL (use http://ollama:11434 in Docker, http://localhost:11434 locally)
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model to use (must be pulled first: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
# Timeout for Ollama requests (seconds)
OLLAMA_TIMEOUT_SECONDS=120

# ===========================================
# Authentication & JWT
# ===========================================
# JWT signing algorithm (RS256 or HS256)
JWT_ALGORITHM=RS256
# Paths to RSA keys (generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Google OAuth (Optional)
# ===========================================
# Get credentials from Google Cloud Console
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ===========================================
# Email / SMTP (Optional - for password reset emails)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=noreply@sophia-ai.local

# ===========================================
# Application Settings
# ===========================================
# Maximum upload size (bytes) - 20 MB default
MAX_UPLOAD_BYTES=20971520

# Text chunking parameters
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# CORS origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5174"]

# Logging
LOG_LEVEL=INFO

# ===========================================
# AI / LLM Settings
# ===========================================
# Ollama model to use (must be pulled: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434
# Timeout for Ollama requests (seconds)
OLLAMA_TIMEOUT_SECONDS=120

# Embedding model (used for vector embeddings)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB path (where vector embeddings are stored)
CHROMA_PATH=./data/chroma

# Text chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Retrieval settings
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.3

# ===========================================
# File Upload
# ===========================================
MAX_UPLOAD_BYTES=20971520

# ===========================================
# Keys Directory
# ===========================================
# Generate keys with:
# openssl genrsa -out keys/private.pem 2048
# openssl rsa -in keys/private.pem -pubout -out keys/public.pem
# JWT_PRIVATE_KEY_PATH=./keys/private.pem
# JWT_PUBLIC_KEY_PATH=./keys/public.pem